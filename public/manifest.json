{
  "manifest_version": 3,
  "name": "DeepWiki Bookmarker",
  "version": "0.1.0",
  "description": "Keep DeepWiki repositories and search sessions organized in your side panel.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "https://deepwiki.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "action": {
    "default_title": "Open DeepWiki Bookmarker",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
